# Hive — Environment Variables
# Hybrid P2P + Relay architecture using GunDB.
# The VPS acts as a relay/superpeer for NAT traversal.
#
# Copy this file to .env and fill in your values.

# GunDB Relay URL (WebSocket endpoint)
RELAY_URL=wss://your-relay.example.com/gun

# Media upload endpoint on the VPS
MEDIA_UPLOAD_URL=https://your-relay.example.com/upload

# App metadata (optional overrides)
# APP_VERSION=3.2.3
# APP_ENV=production
